# Copy this file to .env and fill in the values. Never commit .env.

# Telegram (needed from Step 6). See PLAN-phase0.md, Step 6, for how to get these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tapo "Camera Account" (needed once the real camera is in).
# Use them in config.yaml as ${CAMERA_USER} and ${CAMERA_PASS}.
# Avoid @ : / in the password, because they break RTSP URLs.
CAMERA_USER=
CAMERA_PASS=
